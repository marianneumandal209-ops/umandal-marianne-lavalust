AddDefaultCharset UTF-8
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # NAPAKAHALAGA: Para sa subfolder sa Laragon
    RewriteBase /LavaLust/

    <Files "index.php">
        Require all granted
    </Files>

    RedirectMatch 403 ^/(app|scheme|console|runtime)/

    <FilesMatch "\.(env|json|xml|log|md|lock|git|ini|bak|sql)$">
        Require all denied
    </FilesMatch>

    Options -Indexes

    RewriteCond %{REQUEST_URI} !^/LavaLust/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>